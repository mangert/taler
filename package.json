{
  "name": "taler",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mangert/taler.git"
  },
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "typescript-eslint": "8.70.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend \"npm run start:dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "lint": "npm run lint --workspaces --if-present \u0026\u0026 eslint e2e playwright.config.ts --max-warnings=0",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc -p tsconfig.e2e.json \u0026\u0026 npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run test:e2e --workspace=backend \u0026\u0026 playwright test"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.2": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false,
    "msw": false
  }
}
