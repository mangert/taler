# Local-only example credentials; replace them in .env and never commit real passwords.
DATABASE_URL=postgresql://taler_dev:local_dev_only@localhost:5432/taler_dev?schema=public
TEST_DATABASE_URL=postgresql://taler_test:local_test_only@localhost:5432/taler_test?schema=public
JWT_SECRET=development-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000
CSV_MAX_FILE_SIZE_BYTES=5242880
CSV_MAX_ROWS=10000
